<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>HC Tax — Repayment Script</title>
  <style>
    :root { --hc-blue:#003087; --hc-gold:#C8A84B; --muted:#6b7280; --card:#fff; --bg:#f9fafb; }
    body { font-family: "Segoe UI", Roboto, Arial, sans-serif; margin:0; background:var(--bg); color:#111827; }
    .wrap { max-width:880px; margin:18px auto; padding:16px; }
    .header { background:var(--hc-blue); color:#fff; padding:12px 14px; border-radius:8px; display:flex; gap:12px; align-items:center; }
    .logo { width:36px; height:36px; background:var(--hc-gold); color:var(--hc-blue); border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:700; }
    .card { background:var(--card); border:1px solid #e5e7eb; padding:14px; border-radius:8px; margin-top:14px; }
    .row { display:grid; grid-template-columns: 1fr 1fr; gap:10px 24px; }
    .label { font-size:11px; color:var(--muted); font-weight:700; text-transform:uppercase; letter-spacing:0.04em; margin-bottom:6px; }
    .value { font-size:14px; color:#111827; }
    .btn { background:var(--hc-blue); color:#fff; border:none; padding:8px 12px; border-radius:6px; cursor:pointer; font-weight:700; }
    .muted { color:#9ca3af; }
    .badge { display:inline-block; padding:2px 10px; border-radius:12px; font-weight:700; font-size:12px; }
    .green { background:#d1fae5; color:#065f46; }
    .yellow { background:#fef3c7; color:#92400e; }
    .red { background:#fee2e2; color:#991b1b; }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="header">
      <div class="logo">HC</div>
      <div>
        <div style="font-weight:700">Harris County Tax Office</div>
        <div style="font-size:12px; opacity:0.9">Repayment script</div>
      </div>
    </div>

    <div style="margin-top:12px; display:flex; gap:8px; align-items:center;">
      <label style="font-weight:700; color:#374151; font-size:13px">Account</label>
      <input id="accountInput" style="padding:6px;border-radius:6px;border:1px solid #d1d5db;min-width:220px" placeholder="?accountNumber=PT-100001" />
      <button id="loadBtn" class="btn">Load</button>
      <div style="margin-left:auto; font-size:13px; color:#374151" id="statusLabel"></div>
    </div>

    <div id="content" class="card" aria-live="polite">
      <div style="text-align:center; color:#9ca3af; padding:18px 0">Loading repayment details...</div>
    </div>
  </div>

  <script>
  const LOOKUP_ENDPOINT = "https://wvzqurn6spx6ocgxqesxu4ivcy0yivlt.lambda-url.us-east-1.on.aws/lookup";
  const WRITEBACK_ENDPOINT = "https://wvzqurn6spx6ocgxqesxu4ivcy0yivlt.lambda-url.us-east-1.on.aws/writeback";
  const SENDSMS_ENDPOINT = "https://wvzqurn6spx6ocgxqesxu4ivcy0yivlt.lambda-url.us-east-1.on.aws/sendsms";

  const mockData = {
    "PT-100001": { accountNumber:"PT-100001", name:"Maria Lopez", phone:"13177030977",
      address:"1450 Canal St, Houston, TX 77002", delinquentBalance:"2485.17", repaymentEligibilityStatus:"Eligible",
      downPaymentAmount:"250", repaymentMonths:"12", monthlyPayment:"186.26", repaymentStart:"2026-06-01", confirmationNumber:"HC-TX-9921",
      smsSentTimestamp:"2026-05-01T14:05:00Z", smsReceivedTimestamp:"2026-05-01T14:05:00Z", signatureStatus:"Signed", signedName:"Maria Lopez", signedTimestamp:"2026-05-01T14:06:00Z",
      linkTemplate:"https://genesys-signature-fo-q87qwl.abacusai.app?account=100001&downPayment=250&months=12&monthlyPayment=186.26&startDate=2026-06-01&confirmationNumber=HC-TX-9921",
      useCase:"PT"
    }
  };

  function qs(name) {
    const params = new URLSearchParams(location.search);
    return params.get(name);
  }
  function badgeHTML(status) {
    if (!status) return '<span class="muted">\u2014</span>';
    return '<span class="badge ' + (status==="Signed"||status==="Eligible" ? 'green' : status==="Sent" ? 'yellow' : 'red') + '">' + status + '</span>';
  }

  function renderRepayment(data) {
    document.getElementById("statusLabel").textContent = data.repaymentEligibilityStatus ? data.repaymentEligibilityStatus : "";

    const html = [];
    html.push('<div style="display:grid; grid-template-columns:1fr 1fr; gap:18px">');

    function f(label, v, badge) { return '<div><div class="label">' + label + '</div><div class="value">' + (badge ? badgeHTML(v) : (v || '<span class="muted">\u2014</span>')) + '</div></div>'; }

    html.push('<div>');
    html.push(f("Account", data.accountNumber));
    html.push(f("Name", data.name));
    html.push(f("Address", data.address));
    html.push(f("Delinquent Balance", data.delinquentBalance ? "$" + data.delinquentBalance : null));
    html.push('</div>');

    html.push('<div>');
    html.push(f("Eligibility", data.repaymentEligibilityStatus, true));
    html.push(f("Down Payment", data.downPaymentAmount ? "$" + data.downPaymentAmount : null));
    html.push(f("Months", data.repaymentMonths));
    html.push(f("Monthly Payment", data.monthlyPayment ? "$" + data.monthlyPayment : null));
    html.push(f("Start Date", data.repaymentStart));
    html.push(f("Confirmation #", data.confirmationNumber));
    html.push('</div>');

    html.push('</div>');

    html.push('<div style="margin-top:12px"><div class="label">Agreement / Sign</div>');
    html.push('<div style="display:flex; gap:8px; margin-top:8px">');
    html.push('<button id="openLinkBtn" class="btn">Open Signature Link</button>');
    html.push('<button id="sendSmsBtn" class="btn" style="background:#92400e">Send SMS</button>');
    html.push('<button id="writebackBtn" class="btn" style="background:#065f46">Writeback Agreement</button>');
    html.push('</div></div>');

    html.push('<div style="margin-top:12px" class="card"><div class="label">Agent Talk Track</div>');
    html.push('<div style="font-size:13px; color:#374151; line-height:1.6">');
    html.push('<div>"I have your account pulled up, ' + (data.name||'[Name]') + '. Your delinquent balance is <strong>' + (data.delinquentBalance ? "$" + data.delinquentBalance : '\u2014') + '</strong> and you are eligible for a repayment plan."</div>');
    html.push('<div style="margin-top:6px">"Proposed plan: down payment <strong>' + (data.downPaymentAmount ? '$'+data.downPaymentAmount : '\u2014') + '</strong>, then <strong>' + (data.repaymentMonths||'\u2014') + ' monthly payments</strong> of <strong>' + (data.monthlyPayment ? '$'+data.monthlyPayment : '\u2014') + '</strong> starting <strong>' + (data.repaymentStart || '\u2014') + '</strong>."</div>');
    html.push('<div style="margin-top:6px">"If you agree, I will send a secure link to your phone to sign the agreement. Once signed, I will finalize the record and provide the confirmation number."</div>');
    html.push('</div></div>');

    document.getElementById("content").innerHTML = html.join('');

    document.getElementById("openLinkBtn").addEventListener("click", () => {
      if (!data.linkTemplate) return alert("No linkTemplate found. Configure your data row to include one.");
      const resolved = resolveTemplate(data.linkTemplate, data);
      window.open(resolved, "_blank");
    });

    document.getElementById("writebackBtn").addEventListener("click", () => {
      if (WRITEBACK_ENDPOINT.includes("REPLACE_WITH")) return alert("Set WRITEBACK_ENDPOINT first.");
      const payload = {
        key: data.key || data.accountNumber,
        signatureStatus: "Signed",
        signedName: data.name || "Signed User",
        signedTimestamp: new Date().toISOString(),
        confirmationNumber: data.confirmationNumber || ""
      };
      fetch(WRITEBACK_ENDPOINT, { method:"POST", headers:{"Content-Type":"application/json"}, body:JSON.stringify(payload) })
        .then(r => { if (r.ok) alert("Writeback sent"); else alert("Writeback failed " + r.statusText); })
        .catch(e => alert("Writeback error: " + e.message));
    });

    document.getElementById("sendSmsBtn").addEventListener("click", () => {
      if (SENDSMS_ENDPOINT.includes("REPLACE_WITH")) return alert("Set SENDSMS_ENDPOINT first.");
      const smsBody = `Your repayment agreement ${data.confirmationNumber || ""}. Review: ${data.linkTemplate || ""}`;
      const payload = { fromAddress:"+13178549820", toAddress:"+" + (data.phone||"13177030977"), toAddressMessengerType:"sms", textBody:smsBody };
      fetch(SENDSMS_ENDPOINT, { method:"POST", headers:{"Content-Type":"application/json"}, body:JSON.stringify(payload) })
        .then(r => { if (r.ok) alert("SMS trigger sent"); else alert("SMS failed"); })
        .catch(e => alert("SMS error: " + e.message));
    });
  }

  function resolveTemplate(tpl, data) {
    return tpl.replace(/\{accountNumber\}|\{account\}|\{key\}/gi, encodeURIComponent(data.accountNumber||''))
              .replace(/\{amount\}|\{downPayment\}/gi, encodeURIComponent(data.downPaymentAmount||''))
              .replace(/\{count\}|\{months\}/gi, encodeURIComponent(data.repaymentMonths||''))
              .replace(/\{monthlyPayment\}/gi, encodeURIComponent(data.monthlyPayment||''))
              .replace(/\{date\}/gi, encodeURIComponent(data.repaymentStart||''))
              .replace(/\{number\}|\{confirmationNumber\}/gi, encodeURIComponent(data.confirmationNumber||''));
  }

  async function load(acc) {
    const content = document.getElementById("content");
    content.innerHTML = '<div style="text-align:center; color:#9ca3af; padding:18px 0">Loading repayment details...</div>';
    let data = null;
    if (!acc) acc = qs("accountNumber");
    document.getElementById("accountInput").value = acc || "";
    if (acc && LOOKUP_ENDPOINT) {
      try {
        const url = LOOKUP_ENDPOINT + (LOOKUP_ENDPOINT.includes("?") ? "&" : "?") + "accountNumber=" + encodeURIComponent(acc);
        const r = await fetch(url);
        if (r.ok) data = await r.json();
      } catch (e) { console.warn("lookup error", e); }
    }
    if (!data) data = mockData[acc] || mockData["PT-100001"];
    renderRepayment(data);
  }

  document.getElementById("loadBtn").addEventListener("click", () => {
    const acc = document.getElementById("accountInput").value.trim();
    if (!acc) return alert("Enter accountNumber (e.g., PT-100001).");
    history.replaceState({}, "", location.pathname + "?accountNumber=" + encodeURIComponent(acc));
    load(acc);
  });

  load(qs("accountNumber") || "PT-100001");
  </script>
</body>
</html>
