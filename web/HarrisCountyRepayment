<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Harris County Tax Office - Property Tax Repayment</title>
  <style>
    :root {
      --navy:#1f2f53; --page:#e8eef5; --card:#fff; --line:#dbe4ef; --text:#24324a;
      --muted:#718197; --green:#2b7a45; --blue:#32578f; --blue-bg:#eef4ff; --gold:#c78a1e; --amber:#b06f12; --red:#b3261e;
      --shadow:0 1px 1px rgba(16,24,40,.04), 0 6px 18px rgba(16,24,40,.06); --radius:10px;
    }
    * { box-sizing:border-box; } html,body { margin:0; padding:0; }
    body { font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif; background:var(--page); color:var(--text); }
    .topbar { background:var(--navy); color:#fff; min-height:88px; display:flex; align-items:center; padding:0 26px; box-shadow:inset 0 -1px 0 rgba(255,255,255,.08); }
    .brand { display:flex; align-items:center; gap:16px; min-width:0; }
    .seal { width:44px; height:44px; border-radius:999px; flex:0 0 auto; background:radial-gradient(circle at 35% 35%, #e3f0ff 0 11%, #f7fbff 12% 19%, #2e4f8f 20% 100%); border:2px solid rgba(255,255,255,.7); position:relative; overflow:hidden; }
    .seal::before { content:"TX"; position:absolute; bottom:5px; left:0; right:0; text-align:center; font-size:9px; letter-spacing:1px; opacity:.9; }
    .brand h1 { font-size:22px; line-height:1.1; margin:0; font-weight:700; }
    .brand .sub { margin-top:5px; font-size:13px; color:rgba(255,255,255,.85); }
    .chips { margin-left:auto; display:flex; gap:12px; align-items:center; }
    .chip { background:#edf4ff; color:#35598f; border-radius:999px; padding:9px 16px; font-weight:700; font-size:15px; line-height:1; white-space:nowrap; }
    .btn-refresh { background:rgba(255,255,255,.12); color:#fff; border:1px solid rgba(255,255,255,.4); border-radius:6px; padding:9px 16px; font-size:14px; font-weight:600; cursor:pointer; }
    .btn-refresh:hover { background:rgba(255,255,255,.2); }
    .page { width:min(1120px, calc(100vw - 40px)); margin:18px auto 0; padding-bottom:28px; }
    .card { background:var(--card); border:1px solid var(--line); border-radius:var(--radius); box-shadow:var(--shadow); overflow:hidden; margin-bottom:18px; }
    .card-header { min-height:56px; padding:13px 18px; display:flex; align-items:center; gap:10px; border-bottom:1px solid var(--line); background:linear-gradient(#f8fafc,#f6f8fb); font-size:17px; font-weight:700; }
    .card-body { padding:20px 18px; }
    .icon { font-size:19px; width:22px; text-align:center; opacity:.95; }
    .grid3 { display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); gap:22px 42px; }
    .field-label { font-size:12px; font-weight:800; letter-spacing:1px; color:#7a889b; text-transform:uppercase; margin-bottom:5px; }
    .field-value { font-size:18px; line-height:1.35; color:#232e40; }
    .field-value.big { font-size:26px; font-weight:800; color:#1c2740; }
    .badge { display:inline-block; padding:5px 13px; border-radius:999px; font-size:14px; font-weight:700; }
    .badge.green { background:#e6f4ec; color:var(--green); }
    .badge.amber { background:#fbf0dd; color:var(--amber); }
    .badge.blue { background:var(--blue-bg); color:var(--blue); }
    .field-group { min-height:56px; }
    .helper { color:var(--muted); font-size:13px; margin:0 0 14px; }
    .btnrow { display:flex; gap:12px; flex-wrap:wrap; margin-top:14px; }
    .btn { appearance:none; border:1px solid transparent; border-radius:6px; padding:12px 24px; font-size:15px; font-weight:700; color:#fff; background:#36588d; cursor:pointer; text-decoration:none; display:inline-block; }
    .btn.green { background:#2e6f4f; }
    .btn.ghost { background:#fff; color:#32578f; border-color:#c3d1e6; }
    .link { color:#2f5c9a; text-decoration:underline; word-break:break-all; font-size:15px; }
    .banner { display:none; margin-top:14px; padding:11px 15px; border-radius:8px; font-weight:700; font-size:14px; background:#e6f4ec; color:#1f6b41; }
    .snapshot { background:#0f1b30; color:#d5e2f5; border-radius:8px; padding:18px 20px; font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; font-size:12.5px; line-height:1.6; white-space:pre-wrap; word-break:break-word; }
    .footer { text-align:center; color:#8a96a7; font-size:12px; padding:16px 0; }
    @media (max-width:900px){ .grid3{grid-template-columns:1fr;} .chips .chip{display:none;} }
  .navbar{display:flex;gap:8px;background:#0d2440;padding:10px 20px;border-bottom:1px solid rgba(255,255,255,.12);flex-wrap:wrap}
  .navbar a{color:#cbd5e1;text-decoration:none;padding:8px 16px;border-radius:6px;font-size:14px;font-weight:600;border:1px solid transparent;transition:background .15s}
  .navbar a:hover{background:rgba(255,255,255,.12);color:#fff}
  .navbar a.active{background:#1e40af;color:#fff;border-color:#3b82f6}
  </style>
</head>
<body>
  <header class="topbar">
    <div class="brand">
      <div class="seal" aria-hidden="true"></div>
      <div>
        <h1>Harris County Tax Office</h1>
        <div class="sub">Property Tax Repayment</div>
      </div>
    </div>
    <div class="chips">
      <div class="chip" id="residentIdChip">100001</div>
      <button class="btn-refresh" id="refreshBtn" type="button">Refresh</button>
    </div>
  </header>

  <nav class="navbar" id="navbar">
    <a href="overview.html" data-page="overview">Overview</a>
    <a href="repayment.html" data-page="repayment">Property Tax Repayment</a>
    <a href="registration.html" data-page="registration">New Resident</a>
    <a href="voter-registration.html" data-page="voter">Voter Registration</a>
  </nav>

  <main class="page">
    <section class="card">
      <div class="card-header"><span class="icon">&#128100;</span>Account Information</div>
      <div class="card-body">
        <div class="grid3">
          <div class="field-group"><div class="field-label">Full Name</div><div class="field-value" id="residentName">Maria Lopez</div></div>
          <div class="field-group"><div class="field-label">Phone</div><div class="field-value" id="phone">+1 (317) 703-0977</div></div>
          <div class="field-group"><div class="field-label">Account Number</div><div class="field-value" id="accountNumber">100001</div></div>
        </div>
      </div>
    </section>

    <section class="card">
      <div class="card-header"><span class="icon">&#128176;</span>Delinquent Balance &amp; Eligibility</div>
      <div class="card-body">
        <div class="grid3">
          <div class="field-group"><div class="field-label">Delinquent Balance</div><div class="field-value big" id="delinquentBalance">&mdash;</div></div>
          <div class="field-group"><div class="field-label">Repayment Eligibility</div><div class="field-value"><span class="badge green" id="status">Eligible</span></div></div>
          <div class="field-group"><div class="field-label">Next Action</div><div class="field-value" id="actionRequired">Send repayment agreement</div></div>
        </div>
        <p class="helper" id="statusDetail" style="margin:18px 0 0;">Eligible for a repayment plan.</p>
      </div>
    </section>

    <section class="card">
      <div class="card-header"><span class="icon">&#128221;</span>Repayment Agreement</div>
      <div class="card-body">
        <p class="helper">Send the resident the interactive repayment agreement form to review and sign. Account context is passed automatically.</p>
        <div class="field-group" style="margin-bottom:14px;">
          <div class="field-label">Repayment Agreement Link</div>
          <div class="field-value"><a class="link" id="linkText" href="#" target="_blank" rel="noopener">&mdash;</a></div>
        </div>
        <div class="btnrow" style="margin-top:0;">
          <a class="btn green" id="openFormBtn" href="#" target="_blank" rel="noopener">Open Repayment Agreement</a>
          <button class="btn ghost" type="button" id="sendLinkBtn">Send Agreement by SMS</button>
        </div>
        <div class="banner" id="sendBanner"></div>
      </div>
    </section>

    <section class="card">
      <div class="card-header"><span class="icon">&#128203;</span>Record JSON</div>
      <div class="card-body"><div class="snapshot" id="snapshot">{}</div></div>
    </section>
  </main>
  <div class="footer">Harris County Tax Office &mdash; Internal Agent Tool</div>

  <script>
    const HC_DATA = {
      "100001": {residentID:"100001", serviceType:"PropertyTax", residentName:"Maria Lopez", phone:"13177030977", identifier:"100001", status:"Eligible", statusDetail:"Eligible for a repayment plan.", actionRequired:"Send repayment agreement", link:"https://genesys-signature-fo-q87qwl.abacusai.app?account=100001", smsTemplate:"PropertyTaxRepayment", notes:"Demo property tax scenario"}
    };
    const COLUMNS = ["residentID","serviceType","residentName","phone","identifier","status","statusDetail","actionRequired","link","smsTemplate","notes"];
    const params = new URLSearchParams(window.location.search);
    const ALIASES = { residentID:["accountNumber","account","key","id"] };
    const get = (k) => { let v=params.get(k); if((!v||!v.trim())&&ALIASES[k]){ for(const a of ALIASES[k]){ const av=params.get(a); if(av&&av.trim()){v=av;break;} } } return v&&v.trim()?v.trim():null; };
    function resolveRecord(){ const q=get("residentID"); if(q) return HC_DATA[q]?{...HC_DATA[q]}:{residentID:q}; return {...HC_DATA["100001"]}; }
    const rec = resolveRecord();
    const val = (f,fb="") => { const p=get(f); if(p!==null) return p; return (rec[f]!==undefined&&rec[f]!=="")?rec[f]:fb; };
    const fmtPhone = (p) => { if(!p) return "\u2014"; const d=String(p).replace(/\D/g,""); if(d.length===11&&d[0]==="1") return `+1 (${d.slice(1,4)}) ${d.slice(4,7)}-${d.slice(7)}`; if(d.length===10) return `+1 (${d.slice(0,3)}) ${d.slice(3,6)}-${d.slice(6)}`; return p; };
    const fmtMoney = (v) => { if(v===null||v===undefined||v==="") return "\u2014"; const n=Number(String(v).replace(/[^0-9.\-]/g,"")); if(isNaN(n)) return v; return "$"+n.toLocaleString("en-US",{minimumFractionDigits:2,maximumFractionDigits:2}); };
    const dash = (v)=>(v===null||v===undefined||v==="")?"\u2014":v;
    const set = (id,v)=>{ const el=document.getElementById(id); if(el) el.textContent=v; };

    const residentID = val("residentID");
    const link = val("link");

    set("residentIdChip", dash(residentID));
    set("residentName", dash(val("residentName")));
    set("phone", fmtPhone(val("phone")));
    set("accountNumber", dash(val("identifier") || residentID));
    /* delinquentBalance is optional in the simplified table; show if passed */
    set("delinquentBalance", fmtMoney(val("delinquentBalance")));
    set("actionRequired", dash(val("actionRequired")));
    set("statusDetail", dash(val("statusDetail")));

    const statusEl = document.getElementById("status");
    const status = val("status");
    statusEl.textContent = dash(status);
    const sLow = String(status).toLowerCase();
    statusEl.className = "badge " + (sLow.includes("eligible")||sLow.includes("active")||sLow.includes("ready") ? "green" : (sLow.includes("pending")||sLow.includes("review") ? "amber" : "blue"));

    const linkEl = document.getElementById("linkText");
    if (link) { linkEl.textContent = link; linkEl.href = link; document.getElementById("openFormBtn").href = link; }
    else { document.getElementById("openFormBtn").style.display = "none"; }

    const snap = {}; COLUMNS.forEach(c=>snap[c]=val(c));
    document.getElementById("snapshot").textContent = JSON.stringify(snap, null, 2);

    const sb = document.getElementById("sendBanner");
    document.getElementById("sendLinkBtn").addEventListener("click", () => { sb.textContent = "Repayment agreement sent by SMS to " + fmtPhone(val("phone")) + "."; sb.style.display="block"; setTimeout(()=>{sb.style.display="none";},2800); });
    document.getElementById("refreshBtn").addEventListener("click", () => location.reload());
  </script>

  <script>
    (function(){
      var qs = window.location.search || "";
      var current = "repayment";
      var links = document.querySelectorAll("#navbar a");
      for (var i=0;i<links.length;i++){
        links[i].setAttribute("href", links[i].getAttribute("href") + qs);
        if (links[i].getAttribute("data-page") === current) links[i].classList.add("active");
      }
    })();
  </script>
</body>
</html>
