{
  "meta": {
    "id": "ms-its-medicaid-2026",
    "name": "MS ITS Centralized Medicaid Script",
    "version": "2.0",
    "description": "Statewide Shared Service Script - Focused on Governance, Multi-tenancy, and Operational Supportability.",
    "agency": "Mississippi ITS / Medicaid",
    "branding": {
      "primary_navy": "#0B3C5D",
      "accent_gold": "#F2C649",
      "ui_background": "#F3F4F6"
    }
  },
  "tenant_configuration": {
    "supported_tenants": [
      "Central Mississippi",
      "Gulf Coast",
      "North Mississippi",
      "Northeast Mississippi"
    ],
    "governance_mode": "Strict RBAC - Tenant Isolated",
    "audit_level": "Forensic / All Interactions"
  },
  "ui_layout": {
    "header": {
      "display_fields": ["citizenKey", "tenant_id", "benefitsInterruptionRisk"],
      "style": "sticky-top",
      "alert_triggers": {
        "benefitsInterruptionRisk": "High",
        "medicaidStatus": "Suspended"
      }
    },
    "panes": [
      {
        "id": "citizen_master",
        "title": "Citizen Master View",
        "grid_columns": 3,
        "fields": [
          "name", "dob", "phone", "email", 
          "medicaidStatus", "renewalDueDate", 
          "householdSize", "caseWorkerName", 
          "medicaidCaseId", "regionalOffice"
        ]
      },
      {
        "id": "verification_engine",
        "title": "Document Verification Status",
        "grid_columns": 2,
        "fields": [
          "incomeVerificationStatus", 
          "residencyVerificationStatus", 
          "childVerificationStatus", 
          "missingDocuments"
        ],
        "highlight": "missingDocuments"
      },
      {
        "id": "operational_context",
        "title": "ITS Operational Intelligence",
        "fields": [
          "lastInteractionChannel", 
          "repeatContactCount", 
          "priorEscalationFlag", 
          "aiSummary"
        ]
      },
      {
        "id": "agent_guidance",
        "title": "Recommended Next Steps (AI-Driven)",
        "type": "script-box",
        "content_source": "recommendedNextAction",
        "actions": [
          {
            "label": "Send Secure Upload Link",
            "trigger": "api.ms_its.notification.send_link",
            "log_event": "SERVICE_ACTION: UPLOAD_LINK_SENT"
          },
          {
            "label": "Escalate to Supervisor",
            "trigger": "workflow.escalate",
            "require_reason": true,
            "log_event": "GOVERNANCE: AGENT_ESCALATION"
          }
        ]
      }
    ]
  },
  "agent_script_prompts": {
    "greeting": "Thank you for contacting Mississippi Medicaid Support. This is a secure line. I have your case up for the {{regionalOffice}} region. Am I speaking with {{name}}?",
    "reassurance_active": "I see your renewal is pending, but your benefits remain ACTIVE during this review period. We just need to clear up your {{missingDocuments}}.",
    "reassurance_suspended": "I see your benefits are currently suspended. As this is a critical priority, I am initiating an immediate Supervisor Review to expedite reinstatement.",
    "closing": "Is there anything else I can assist you with regarding your {{regionalOffice}} account today?"
  },
  "governance_logic": {
    "auto_dispositions": [
      {
        "condition": "medicaidStatus == 'Suspended'",
        "suggested_code": "SuspensionReview"
      },
      {
        "condition": "repeatContactCount > 2",
        "suggested_code": "UploadEscalation"
      }
    ],
    "billing_tags": [
      "tenant_id",
      "interaction_duration",
      "channel_type"
    ]
  },
  "demo_data_mapping": [
    {
      "scenario": "Angela Carter",
      "target_script_flow": "RenewalGuidance",
      "expected_outcome": "Resolution via Document Link"
    },
    {
      "scenario": "James Turner",
      "target_script_flow": "SuspensionReview",
      "expected_outcome": "Supervisor Escalation"
    }
  ]
}
