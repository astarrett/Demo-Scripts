<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Harris County Tax Office - Agent Overview</title>
  <style>
    :root {
      --navy: #1f2f53; --page: #e8eef5; --card: #ffffff; --line: #dbe4ef;
      --text: #24324a; --muted: #718197; --green: #2b7a45; --blue: #32578f;
      --blue-bg: #eef4ff; --gold: #c78a1e; --amber:#b06f12; --red:#b3261e;
      --shadow: 0 1px 1px rgba(16,24,40,.04), 0 6px 18px rgba(16,24,40,.06);
      --radius: 10px;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background: var(--page); color: var(--text); }
    .topbar { background: var(--navy); color:#fff; min-height: 88px; display:flex; align-items:center; padding: 0 26px; box-shadow: inset 0 -1px 0 rgba(255,255,255,.08); }
    .brand { display:flex; align-items:center; gap:16px; min-width:0; }
    .seal { width:44px; height:44px; border-radius:999px; flex:0 0 auto; background: radial-gradient(circle at 35% 35%, #e3f0ff 0 11%, #f7fbff 12% 19%, #2e4f8f 20% 100%); border:2px solid rgba(255,255,255,.7); position:relative; overflow:hidden; }
    .seal::before { content:"TX"; position:absolute; bottom:5px; left:0; right:0; text-align:center; font-size:9px; letter-spacing:1px; opacity:.9; }
    .brand h1 { font-size:22px; line-height:1.1; margin:0; font-weight:700; }
    .brand .sub { margin-top:5px; font-size:13px; color: rgba(255,255,255,.85); }
    .chips { margin-left:auto; display:flex; gap:12px; align-items:center; }
    .chip { background:#edf4ff; color:#35598f; border-radius:999px; padding:9px 16px; font-weight:700; font-size:15px; line-height:1; white-space:nowrap; }
    .btn-refresh { background: rgba(255,255,255,.12); color:#fff; border:1px solid rgba(255,255,255,.4); border-radius:6px; padding:9px 16px; font-size:14px; font-weight:600; cursor:pointer; }
    .btn-refresh:hover { background: rgba(255,255,255,.2); }
    .page { width:min(1160px, calc(100vw - 40px)); margin:18px auto 0; padding-bottom:28px; }
    .cols { display:grid; grid-template-columns: 1.4fr 1fr; gap:18px; align-items:start; }
    .card { background:var(--card); border:1px solid var(--line); border-radius:var(--radius); box-shadow:var(--shadow); overflow:hidden; margin-bottom:18px; }
    .card-header { min-height:56px; padding:13px 18px; display:flex; align-items:center; gap:10px; border-bottom:1px solid var(--line); background:linear-gradient(#f8fafc,#f6f8fb); font-size:17px; font-weight:700; }
    .card-body { padding:20px 18px; }
    .icon { font-size:19px; width:22px; text-align:center; opacity:.95; }
    .field-label { font-size:12px; font-weight:800; letter-spacing:1px; color:#7a889b; text-transform:uppercase; margin-bottom:5px; }
    .field-value { font-size:18px; line-height:1.35; color:#232e40; margin-bottom:18px; }
    .field-value:last-child { margin-bottom:0; }
    .badge { display:inline-block; padding:5px 13px; border-radius:999px; font-size:14px; font-weight:700; }
    .badge.svc { background:var(--blue-bg); color:var(--blue); }
    .badge.green { background:#e6f4ec; color:var(--green); }
    .badge.amber { background:#fbf0dd; color:var(--amber); }
    .badge.blue { background:var(--blue-bg); color:var(--blue); }
    .btnrow { display:flex; gap:12px; flex-wrap:wrap; margin-top:4px; }
    .btn { appearance:none; border:1px solid transparent; border-radius:6px; padding:12px 24px; font-size:15px; font-weight:700; color:#fff; background:#36588d; cursor:pointer; text-decoration:none; display:inline-block; }
    .btn.green { background:#2e6f4f; }
    .btn.ghost { background:#fff; color:#32578f; border-color:#c3d1e6; }
    .btn.block { display:block; width:100%; text-align:center; margin-bottom:10px; }
    .helper { color:var(--muted); font-size:13px; margin:0 0 14px; }
    .snapshot { background:#0f1b30; color:#d5e2f5; border-radius:8px; padding:18px 20px; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size:12.5px; line-height:1.6; white-space:pre-wrap; word-break:break-word; }
    .script-box { background:#f6f8fb; border:1px solid #e2e9f2; border-left:4px solid var(--blue); border-radius:8px; padding:14px 16px; }
    .script-box .lead { font-size:16px; font-weight:700; color:#22314c; margin-bottom:6px; }
    .script-box .detail { font-size:14px; color:#48576e; line-height:1.5; }
    .footer { text-align:center; color:#8a96a7; font-size:12px; padding:16px 0; }
    @media (max-width: 900px){ .cols{ grid-template-columns:1fr; } .chips .chip{ display:none; } }
  .navbar{display:flex;gap:8px;background:#0d2440;padding:10px 20px;border-bottom:1px solid rgba(255,255,255,.12);flex-wrap:wrap}
  .navbar a{color:#cbd5e1;text-decoration:none;padding:8px 16px;border-radius:6px;font-size:14px;font-weight:600;border:1px solid transparent;transition:background .15s}
  .navbar a:hover{background:rgba(255,255,255,.12);color:#fff}
  .navbar a.active{background:#1e40af;color:#fff;border-color:#3b82f6}
  </style>
</head>
<body>
  <header class="topbar">
    <div class="brand">
      <div class="seal" aria-hidden="true"></div>
      <div>
        <h1>Harris County Tax Office</h1>
        <div class="sub">Agent Overview</div>
      </div>
    </div>
    <div class="chips">
      <div class="chip" id="residentIdChip">100001</div>
      <button class="btn-refresh" id="refreshBtn" type="button">Refresh</button>
    </div>
  </header>

  <nav class="navbar" id="navbar">
    <a href="overview.html" data-page="overview">Overview</a>
    <a href="repayment.html" data-page="repayment">Property Tax Repayment</a>
    <a href="registration.html" data-page="registration">New Resident</a>
    <a href="voter-registration.html" data-page="voter">Voter Registration</a>
  </nav>

  <main class="page">
    <div class="cols">
      <!-- LEFT COLUMN -->
      <div>
        <section class="card">
          <div class="card-header"><span class="icon">&#128100;</span>Customer Snapshot</div>
          <div class="card-body">
            <div class="field-label">Full Name</div>
            <div class="field-value" id="residentName">Maria Lopez</div>
            <div class="field-label">Phone</div>
            <div class="field-value" id="phone">+1 (317) 703-0977</div>
            <div class="field-label">Service Type</div>
            <div class="field-value"><span class="badge svc" id="serviceType">Property Tax</span></div>
            <div class="field-label" id="identifierLabel">Account Number</div>
            <div class="field-value" id="identifier">100001</div>
            <div class="field-label">Status</div>
            <div class="field-value"><span class="badge green" id="status">Eligible</span></div>
            <div class="field-label">Status Detail</div>
            <div class="field-value" id="statusDetail">Eligible for a repayment plan.</div>
          </div>
        </section>

        <section class="card">
          <div class="card-header"><span class="icon">&#128172;</span>Agent Script</div>
          <div class="card-body">
            <div class="script-box">
              <div class="lead" id="scriptLead">Hi Maria, I have your account here.</div>
              <div class="detail" id="scriptDetail">Status: Eligible. Eligible for a repayment plan.</div>
            </div>
          </div>
        </section>

        <section class="card">
          <div class="card-header"><span class="icon">&#128279;</span>Next Action</div>
          <div class="card-body">
            <p class="helper" id="actionRequired">Send repayment agreement</p>
            <div class="btnrow" id="actionButtons"></div>
          </div>
        </section>
      </div>

      <!-- RIGHT COLUMN -->
      <div>
        <section class="card">
          <div class="card-header"><span class="icon">&#128203;</span>Record JSON</div>
          <div class="card-body">
            <div class="snapshot" id="snapshot">{}</div>
          </div>
        </section>

        <section class="card">
          <div class="card-header"><span class="icon">&#9889;</span>Quick Actions</div>
          <div class="card-body">
            <button class="btn block green" type="button" id="qaResendSms">Resend SMS Form</button>
            <button class="btn block ghost" type="button" id="qaCopyAccount">Copy Account</button>
            <button class="btn block ghost" type="button" id="qaCopyLink">Copy Link</button>
            <div class="banner-slot" id="qaMsg" style="display:none; margin-top:10px; padding:9px 13px; border-radius:8px; background:#e6f4ec; color:#1f6b41; font-weight:700; font-size:13px;"></div>
          </div>
        </section>
      </div>
    </div>
  </main>
  <div class="footer">Harris County Tax Office &mdash; Internal Agent Tool</div>

  <script>
    /* ---------- Embedded demo dataset (Andy-HCTax2 simplified) ---------- */
    const HC_DATA = {
      "100001": {residentID:"100001", serviceType:"PropertyTax", residentName:"Maria Lopez", phone:"13177030977", identifier:"100001", status:"Eligible", statusDetail:"Eligible for a repayment plan.", actionRequired:"Send repayment agreement", link:"https://genesys-signature-fo-q87qwl.abacusai.app?account=100001", smsTemplate:"PropertyTaxRepayment", notes:"Demo property tax scenario"},
      "100002": {residentID:"100002", serviceType:"NewResident", residentName:"Priya Nair", phone:"13177030977", identifier:"NR-202601", status:"Pending Verification", statusDetail:"Awaiting Welcome Package Code verification.", actionRequired:"Verify Welcome Package Code", link:"https://hctaxregistration.abacusai.app/?accountNumber=100002", smsTemplate:"NewResidentRegistration", notes:"Demo new resident scenario"},
      "100003": {residentID:"100003", serviceType:"VoterRegistration", residentName:"James Carter", phone:"13177030977", identifier:"HarrisVotes", status:"Ready", statusDetail:"Provide voter registration information.", actionRequired:"Send voter registration link", link:"https://www.harrisvotes.com", smsTemplate:"VoterRegistration", notes:"Demo voter registration scenario"}
    };

    const COLUMNS = ["residentID","serviceType","residentName","phone","identifier","status","statusDetail","actionRequired","link","smsTemplate","notes"];
    const params = new URLSearchParams(window.location.search);
    const ALIASES = { residentID: ["accountNumber","account","key","id"] };
    const get = (k) => {
      let v = params.get(k);
      if ((!v || !v.trim()) && ALIASES[k]) { for (const a of ALIASES[k]) { const av = params.get(a); if (av && av.trim()) { v = av; break; } } }
      return v && v.trim() ? v.trim() : null;
    };
    /* Resolve base record from residentID (falls back to first demo record) */
    function resolveRecord() {
      const q = get("residentID");
      if (q) return HC_DATA[q] ? {...HC_DATA[q]} : { residentID: q };
      return {...HC_DATA["100001"]};
    }
    const rec = resolveRecord();
    /* URL params override embedded values */
    const val = (f, fb="") => { const p = get(f); if (p !== null) return p; return (rec[f] !== undefined && rec[f] !== "") ? rec[f] : fb; };

    const fmtPhone = (p) => { if (!p) return "\u2014"; const d = String(p).replace(/\D/g,""); if (d.length===11 && d[0]==="1") return `+1 (${d.slice(1,4)}) ${d.slice(4,7)}-${d.slice(7)}`; if (d.length===10) return `+1 (${d.slice(0,3)}) ${d.slice(3,6)}-${d.slice(6)}`; return p; };
    const dash = (v) => (v===null||v===undefined||v==="") ? "\u2014" : v;
    const set = (id,v) => { const el=document.getElementById(id); if(el) el.textContent=v; };
    const prettyService = (s) => ({PropertyTax:"Property Tax", NewResident:"New Resident", VoterRegistration:"Voter Registration"}[s] || s || "\u2014");

    const residentID = val("residentID");
    const serviceType = val("serviceType");
    const residentName = val("residentName");
    const link = val("link");

    set("residentIdChip", dash(residentID));
    set("residentName", dash(residentName));
    set("phone", fmtPhone(val("phone")));
    set("serviceType", prettyService(serviceType));
    set("identifier", dash(val("identifier")));
    set("statusDetail", dash(val("statusDetail")));
    set("actionRequired", dash(val("actionRequired")));

    /* identifier label varies by service type */
    set("identifierLabel", serviceType === "NewResident" ? "Welcome Package Code" : (serviceType === "VoterRegistration" ? "Reference" : "Account Number"));

    /* status badge colouring */
    const statusEl = document.getElementById("status");
    const status = val("status");
    statusEl.textContent = dash(status);
    const sLow = String(status).toLowerCase();
    statusEl.className = "badge " + (sLow.includes("eligible")||sLow.includes("ready")||sLow.includes("verified") ? "green" : (sLow.includes("pending")||sLow.includes("await") ? "amber" : "blue"));

    /* Agent script */
    const firstName = String(residentName||"").split(" ")[0] || "there";
    set("scriptLead", `Hi ${firstName}, I have your account here.`);
    set("scriptDetail", `Status: ${dash(status)}. ${dash(val("statusDetail"))}`);

    /* Build a forwarding query string carrying every known column */
    function ctxParams() {
      const fwd = new URLSearchParams();
      COLUMNS.forEach(c => { const v = val(c); if (v !== "" && v !== null && v !== undefined) fwd.set(c, v); });
      if (!fwd.get("accountNumber") && residentID) fwd.set("accountNumber", residentID);
      return fwd.toString();
    }
    const ctx = ctxParams();

    /* Action buttons depend on serviceType */
    const btnWrap = document.getElementById("actionButtons");
    function addBtn(label, href, cls) {
      const a = document.createElement("a");
      a.className = "btn " + (cls||"");
      a.textContent = label;
      a.href = href;
      if (/^https?:/i.test(href)) { a.target = "_blank"; a.rel = "noopener"; }
      btnWrap.appendChild(a);
    }
    if (serviceType === "PropertyTax") {
      addBtn("Open Repayment", "HarrisCountyRepayment.html?" + ctx, "");
      if (link) addBtn("Open Signature Form", link, "ghost");
    } else if (serviceType === "NewResident") {
      addBtn("Open Registration", "HarrisCountyRegistration.html?" + ctx, "green");
      if (link) addBtn("Open Registration Form", link, "ghost");
    } else if (serviceType === "VoterRegistration") {
      if (link) addBtn("Open Voter Link", link, "");
      addBtn("Send Voter Registration Link", link || "#", "ghost");
    } else {
      if (link) addBtn("Open Link", link, "");
    }

    /* Record JSON */
    const snap = {};
    COLUMNS.forEach(c => { snap[c] = val(c); });
    document.getElementById("snapshot").textContent = JSON.stringify(snap, null, 2);

    /* Quick actions */
    const qaMsg = document.getElementById("qaMsg");
    const flash = (msg) => { qaMsg.textContent = msg; qaMsg.style.display="block"; setTimeout(()=>{qaMsg.style.display="none";}, 2600); };
    const copy = (txt, msg) => { navigator.clipboard && navigator.clipboard.writeText(txt).then(()=>flash(msg), ()=>flash(msg)); if(!navigator.clipboard) flash(msg); };
    document.getElementById("qaResendSms").addEventListener("click", () => flash(`SMS form (${dash(val("smsTemplate"))}) re-sent to ${fmtPhone(val("phone"))}.`));
    document.getElementById("qaCopyAccount").addEventListener("click", () => copy(String(residentID||""), "Account number copied."));
    document.getElementById("qaCopyLink").addEventListener("click", () => copy(String(link||""), "Link copied."));
    document.getElementById("refreshBtn").addEventListener("click", () => location.reload());
  </script>

  <script>
    (function(){
      var qs = window.location.search || "";
      var current = "overview";
      var links = document.querySelectorAll("#navbar a");
      for (var i=0;i<links.length;i++){
        links[i].setAttribute("href", links[i].getAttribute("href") + qs);
        if (links[i].getAttribute("data-page") === current) links[i].classList.add("active");
      }
    })();
  </script>
</body>
</html>
